---
import { Image } from "astro:assets";
import { formatDate, postPath } from "../lib/posts.js";

// 칸 맨 위에 크게 놓는 최신 글. 대표 이미지가 있으면 함께 보인다.
const { post } = Astro.props;
const { title, description, cover, pubDatetime } = post.data;
---

<article class="lead">
  <a href={postPath(post)}>
    {
      cover && (
        <Image
          class="cover"
          src={cover}
          alt=""
          widths={[480, 720, 1080]}
          sizes="(min-width: 900px) 32rem, 100vw"
          loading="eager"
        />
      )
    }
    <h3>{title}</h3>
  </a>
  <p class="desc">{description}</p>
  <time class="date" datetime={pubDatetime.toISOString()}>{formatDate(pubDatetime)}</time>
</article>

<style>
  .lead {
    display: grid;
    gap: 0.55rem;
  }
  .cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    margin-bottom: 0.9rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
  }
  h3 {
    font-size: 1.375rem;
    line-height: 1.4;
    font-weight: 740;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  a:hover h3 {
    color: var(--accent);
  }
  .desc {
    color: var(--muted);
    line-height: 1.65;
  }
</style>
