---
import { render } from "astro:content";
import config from "virtual:doksam/config";
import Base from "../layouts/Base.astro";
import Icon from "./Icon.astro";
import Tags from "./Tags.astro";
import { link, t, tx } from "../lib/i18n.js";
import { formatDate, getPosts, postPath, sectionOf } from "../lib/posts.js";

const { post } = Astro.props;
const { title, description, cover, pubDatetime, modDatetime, tags, lang, canonicalURL, toc, showTableOfContents } =
  post.data;
const { Content, headings } = await render(post);
const tocHeadings = (headings ?? []).filter(h => h.depth >= 2 && h.depth <= 3);
const showToc = toc !== false && showTableOfContents !== false && tocHeadings.length > 0;

const section = config.sections.find(s => s.id === sectionOf(post));
const posts = await getPosts(lang);

// 이전·다음은 같은 섹션 안에서만 잇는다.
const siblings = posts.filter(p => sectionOf(p) === sectionOf(post));
const index = siblings.findIndex(p => p.id === post.id);
const newer = index > 0 ? siblings[index - 1] : undefined;
const older = index >= 0 ? siblings[index + 1] : undefined;

// 다른 언어판은 같은 파일 이름으로 찾는다(ko/foo ↔ en/foo). 없으면 그 언어 첫 화면.
const alternates: Record<string, string> = {};
for (const other of config.locales.filter(l => l !== lang)) {
  const twinId = post.id.replace(new RegExp(`^${lang}/`), `${other}/`);
  const twin = twinId === post.id ? undefined : (await getPosts(other)).find(p => p.id === twinId);
  alternates[other] = twin ? postPath(twin) : link("/", other);
}

const modified = modDatetime && modDatetime > pubDatetime ? modDatetime : undefined;
---

<Base
  lang={lang}
  title={title}
  description={description}
  image={cover?.src}
  canonical={canonicalURL}
  alternates={alternates}
  article={{ published: pubDatetime, modified }}
  section={sectionOf(post)}
>
  <div class="read-progress" aria-hidden="true"><span></span></div>
  <div class:list={["wrap read", { "has-toc": showToc }]} data-pagefind-body>
    <header class="post-head">
      {
        section && (
          <a class="section" href={link(`/${section.id}`, lang)}>
            {tx(section.label, lang)}
          </a>
        )
      }
      <h1 class="page-title">{title}</h1>
      <p class="meta">
        <time class="date" datetime={pubDatetime.toISOString()}>{formatDate(pubDatetime)}</time>
        {
          modified && (
            <span class="date">
              · {t(lang, "updated")} {formatDate(modified)}
            </span>
          )
        }
      </p>
    </header>

    <div class="post-body">
      {
        showToc && (
          <aside class="toc" aria-labelledby="toc-title" data-pagefind-ignore>
            <strong class="toc-title" id="toc-title">{t(lang, "toc")}</strong>
            <nav>
              <ul>
                {tocHeadings.map(h => (
                  <li class:list={[{ sub: h.depth === 3 }]}>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ul>
            </nav>
          </aside>
        )
      }

      <div class="post-main">
        <article class="prose">
          <Content />
        </article>

        {
          tags.length > 0 && (
            <div class="post-tags" data-pagefind-ignore>
              <Tags tags={tags} lang={lang} />
            </div>
          )
        }

        {
          (newer || older) && (
            <nav class="pager" data-pagefind-ignore>
              {older ? (
                <a href={postPath(older)}>
                  <span>
                    <Icon name="arrow-left" size="0.95em" />
                    {t(lang, "prev")}
                  </span>
                  <strong>{older.data.title}</strong>
                </a>
              ) : (
                <span />
              )}
              {newer && (
                <a class="next" href={postPath(newer)}>
                  <span>
                    {t(lang, "next")}
                    <Icon name="arrow-right" size="0.95em" />
                  </span>
                  <strong>{newer.data.title}</strong>
                </a>
              )}
            </nav>
          )
        }
      </div>
    </div>
  </div>
</Base>

<script is:inline>
  // 읽기 진행선과 목차의 현재 위치 표시. 스크롤마다 한 프레임에 한 번만 계산한다.
  (function () {
    var bar = document.querySelector(".read-progress span");
    var toc = document.querySelector(".toc");
    var items = [];
    if (toc) {
      toc.querySelectorAll("nav a[href^='#']").forEach(function (a) {
        var id = a.getAttribute("href").slice(1);
        try {
          id = decodeURIComponent(id);
        } catch (e) {}
        var h = document.getElementById(id);
        if (h) items.push({ a: a, h: h });
      });
    }
    var root = document.documentElement;
    var active = null;
    var queued = false;
    function update() {
      queued = false;
      var max = root.scrollHeight - window.innerHeight;
      if (bar) bar.style.transform = "scaleX(" + (max > 0 ? Math.min(1, window.scrollY / max) : 0) + ")";
      if (!items.length) return;
      var line = (parseFloat(getComputedStyle(root).scrollPaddingTop) || 80) + 8;
      var current = null;
      for (var i = 0; i < items.length; i++) {
        if (items[i].h.getBoundingClientRect().top <= line) current = items[i].a;
      }
      if (max > 0 && window.scrollY >= max - 2) current = items[items.length - 1].a;
      if (current === active) return;
      if (active) active.removeAttribute("aria-current");
      active = current;
      if (!active) return;
      active.setAttribute("aria-current", "location");
      // 목차가 따로 스크롤될 때만 현재 항목을 그 안에서 보이게 한다. 페이지는 움직이지 않는다.
      if (toc.scrollHeight > toc.clientHeight) {
        var t = toc.getBoundingClientRect();
        var r = active.getBoundingClientRect();
        if (r.top < t.top) toc.scrollTop -= t.top - r.top + 8;
        else if (r.bottom > t.bottom) toc.scrollTop += r.bottom - t.bottom + 8;
      }
    }
    function onScroll() {
      if (queued) return;
      queued = true;
      requestAnimationFrame(update);
    }
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
    update();
  })();
</script>

<style>
  /* 읽기 진행선. 고정 머리말(z-index 5) 위, 건너뛰기 링크(10) 아래에 둔다. */
  .read-progress {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 6;
    height: 3px;
    pointer-events: none;
  }
  .read-progress span {
    display: block;
    height: 100%;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
  }
  .post-head {
    margin-bottom: 2.25rem;
  }
  .section {
    display: inline-block;
    margin-bottom: 0.75rem;
    padding: 0.1rem 0.65rem;
    border-radius: var(--radius-pill);
    background: var(--accent-soft);
    color: var(--accent);
    font-size: 0.8125rem;
    font-weight: 680;
  }
  .page-title {
    text-wrap: balance;
  }
  .meta {
    margin-top: 0.75rem;
  }
  .toc {
    margin-bottom: 2rem;
    padding: 0.9rem 1.1rem;
    border-left: 2px solid var(--line);
    font-size: 0.875rem;
    line-height: 1.55;
  }
  .toc-title {
    display: block;
    margin-bottom: 0.55rem;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .toc nav ul {
    display: grid;
    gap: 0.35rem;
  }
  .toc nav li.sub {
    padding-left: 0.9rem;
  }
  .toc nav a {
    color: var(--muted);
    text-decoration: none;
  }
  .toc nav a:hover {
    color: var(--accent);
  }
  .toc nav a[aria-current="location"] {
    color: var(--accent);
    font-weight: 650;
  }
  @media (min-width: 1024px) {
    .wrap.read.has-toc {
      max-width: var(--w-wide);
    }
    .has-toc .post-head {
      max-width: var(--w-read);
    }
    .has-toc .post-body {
      display: grid;
      grid-template-columns: minmax(0, var(--w-read)) minmax(13rem, 16rem);
      justify-content: space-between;
      align-items: start;
      gap: 3rem;
    }
    .has-toc .post-main {
      order: 1;
      min-width: 0;
    }
    .has-toc .toc {
      order: 2;
      position: sticky;
      top: calc(var(--head-h) + 1.5rem);
      max-height: calc(100svh - var(--head-h) - 3rem);
      overflow-y: auto;
      margin-bottom: 0;
      padding: 0.25rem 0 0.25rem 1rem;
    }
  }
  .post-tags {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 2rem;
  }
  .pager a {
    display: grid;
    gap: 0.3rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .pager a:hover {
    border-color: var(--accent);
  }
  .pager span {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .pager strong {
    font-weight: 650;
    line-height: 1.45;
  }
  .pager .next {
    text-align: right;
  }
  .pager .next span {
    justify-content: flex-end;
  }
  @media (max-width: 560px) {
    .pager {
      grid-template-columns: 1fr;
    }
  }
</style>
