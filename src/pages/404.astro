---
import Base from "../layouts/Base.astro";
import config from "virtual:doksam/config";
import { link, t } from "../lib/i18n.js";

const lang = config.defaultLocale;
---

<Base lang={lang} title="404">
  <div class="wrap read" style="padding-block:4rem;text-align:center">
    <p class="date" style="font-size:1rem">404</p>
    <h1 class="page-title" style="margin-top:0.5rem">{t(lang, "notFound")}</h1>
    <p style="margin-top:1.5rem">
      <a href={link("/", lang)} style="color:var(--accent);text-decoration:underline">
        {t(lang, "goHome")}
      </a>
    </p>
  </div>
</Base>
