---
import config from "virtual:doksam/config";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { getLang, prefix, swapLang, tx, withBase } from "../lib/i18n.js";
import "../styles/theme.css";

type Props = {
  title?: string;
  description?: string;
  lang?: string;
  /** 대표 이미지 경로. 없으면 og:image 를 내지 않는다. */
  image?: string;
  canonical?: string;
  /** 다른 언어판 주소. 넘기지 않으면 현재 경로에서 언어만 바꾼다. */
  alternates?: Record<string, string>;
  article?: { published: Date; modified?: Date | null };
  /** 글 화면에서 메뉴에 강조할 섹션 id. */
  section?: string;
};

const lang = Astro.props.lang ?? getLang(Astro.url);
const {
  title,
  description = tx(config.description, lang),
  image,
  canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href,
  alternates,
  article,
  section,
} = Astro.props;

const fullTitle = title ? `${title} | ${config.title}` : config.title;
const origin = Astro.site ?? Astro.url;
const imageUrl = image ? new URL(image, origin).href : undefined;
const published = article?.published.toISOString();
const modified = article?.modified?.toISOString();
const rssHref = prefix(lang) + "/rss.xml";
// 짝이 확실한 화면(글이 아닌 화면)에만 hreflang 을 낸다.
const hreflangs = alternates
  ? []
  : config.locales.map(l => ({
      code: l,
      href: new URL(swapLang(Astro.url, l), origin).href,
    }));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        var saved = null;
        try {
          saved = localStorage.getItem("theme");
        } catch (e) {}
        var dark = saved
          ? saved === "dark"
          : window.matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.dataset.theme = dark ? "dark" : "light";
      })();
    </script>
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {config.author && <meta name="author" content={config.author} />}
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <link rel="canonical" href={canonical} />
    {
      hreflangs.map(h => (
        <link rel="alternate" hreflang={h.code} href={h.href} />
      ))
    }
    <link rel="alternate" type="application/rss+xml" title={config.title} href={rssHref} />

    <meta property="og:site_name" content={config.title} />
    <meta property="og:title" content={title ?? config.title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:url" content={new URL(Astro.url.pathname, origin).href} />
    <meta property="og:locale" content={lang} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    <meta name="twitter:card" content={imageUrl ? "summary_large_image" : "summary"} />
    {published && <meta property="article:published_time" content={published} />}
    {modified && <meta property="article:modified_time" content={modified} />}
    <slot name="head" />
  </head>
  <body>
    <Header lang={lang} alternates={alternates} section={section} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
